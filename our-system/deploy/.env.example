# Copy as deploy/.env outside version control; values below contain no credentials.
AML_PROFILE=cycle2_dense
AML_RETRIEVAL_MODE=raw_hybrid_rrf
AML_ENABLE_VECTOR=true
AML_DB_PATH=/var/lib/aml/cycle2-v4.sqlite
AML_AUTH_MODE=bearer
AML_SERVICE_KEY_ENV=AML_SERVICE_API_KEY
AML_SERVICE_API_KEY=
AML_EMBEDDING_PROVIDER=dashscope
# Replace the host with the console's real workspace API Host for this region.
AML_EMBEDDING_ENDPOINT=https://REPLACE-WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
AML_EMBEDDING_REGION=cn-beijing
AML_EMBEDDING_MODEL=text-embedding-v4
AML_EMBEDDING_DIMENSIONS=1024
AML_EMBEDDING_REVISION=1
AML_EMBEDDING_KEY_ENV=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=
AML_EMBEDDING_BATCH_SIZE=10
AML_EMBEDDING_TIMEOUT_SECONDS=30
AML_EMBEDDING_MAX_RETRIES=0
# Conservative byte gate, not a supplier tokenizer count; never truncates.
AML_EMBEDDING_MAX_INPUT_BYTES=8192
# Process-local admission spacing, shared by query/document; 0 disables it.
# With nonzero spacing, requests arriving too early fail rather than queue.
AML_EMBEDDING_MIN_INTERVAL_SECONDS=0
AML_COORDINATOR_LOCK_TIMEOUT_SECONDS=30
AML_MAX_CONCURRENT_REQUESTS=32
AML_MAX_REQUEST_BYTES=10485760
AML_CANDIDATE_LIMIT=200
AML_LEXICAL_QUOTA=100
AML_DENSE_QUOTA=100
AML_MAX_RETURN_ITEMS=100
AML_RETURN_CHAR_BUDGET=32000
# A deployment budget candidate; this does not establish official Answer limits.
AML_RETURN_TOKEN_BUDGET=117760
AML_PACKING_POLICY=prefix
AML_ROUTE_POLICY=none
AML_ENABLE_GOVERNANCE=false
AML_EXACT_DENSE_ACCELERATION=false
# Fill in the TLS reverse proxy separately; never put API keys in URLs.
# Operator checklist. The Python process does not read AML_OPERATOR_* names.
# Replace every REPLACE_* value before a public deployment. Do not commit real
# keys, certificates, workspace credentials, or customer content.
# AML_OPERATOR_WORKSPACE_ID must match the host label inside AML_EMBEDDING_ENDPOINT.
# The endpoint placeholder uses uppercase so it cannot pass the runtime host check
# until an operator substitutes the console workspace host.
# Key material stays empty above. Inject AML_SERVICE_API_KEY and DASHSCOPE_API_KEY
# from a secret manager into the process environment; do not bake key files into the image.
AML_OPERATOR_WORKSPACE_ID=REPLACE_WORKSPACE
AML_OPERATOR_PUBLIC_DOMAIN=REPLACE_DOMAIN
AML_OPERATOR_TLS_FULLCHAIN_PATH=/etc/ssl/aml/fullchain.pem
AML_OPERATOR_TLS_PRIVKEY_PATH=/etc/ssl/aml/privkey.pem
AML_OPERATOR_MACHINE_CPUS=2
AML_OPERATOR_MACHINE_MEMORY=2g
AML_OPERATOR_DATA_RETENTION=REPLACE_RETENTION
AML_OPERATOR_LOG_RETENTION=json-file-10m-x3
AML_OPERATOR_KEY_STORE=secret-manager-env-injection
